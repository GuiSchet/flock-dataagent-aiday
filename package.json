{
  "name": "flock-dataagent",
  "version": "0.1.0",
  "private": true,
  "description": "Agente de voz que co-diseña visualizaciones de datos con el usuario, sobre el corpus de Flock",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:agent": "vite-node -c vitest.config.ts elevenlabs/sync.ts",
    "data:synthetic": "vite-node -c vitest.config.ts scripts/generate-synthetic.ts",
    "bench:voice": "vite-node -c vitest.config.ts scripts/voice-bench/run.ts --",
    "audit:tokens": "vite-node -c vitest.config.ts scripts/audit-tokens.ts",
    "screenshots": "vite-node -c vitest.config.ts scripts/screenshots.ts --"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.72",
    "@elevenlabs/react": "^1.15.2",
    "@json-render/core": "0.21.0",
    "@json-render/react": "0.21.0",
    "ai": "^7.0.109",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.548.0",
    "motion": "^13.4.0",
    "next": "^16.3.5",
    "papaparse": "^5.7.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
