# ElevenLabs Conversational AI — la voz del agente.
# Ambas quedan del lado del servidor. Sin prefijo NEXT_PUBLIC_.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# OpenAI — composición del spec (etapa 3). La intención la produce el agente de voz.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Opcional. Por defecto, el más bajo que admite el modelo ("none" en gpt-5.1 a 5.6,
# "minimal" en gpt-5, "low" en gpt-6). Subirlo multiplica la espera: con su esfuerzo por
# defecto, gpt-5 tarda más de 40 s en emitir el primer parche.
# OPENAI_REASONING_EFFORT=none

# Login: una contraseña compartida para toda la app. Sin estas dos, la app responde 503.
# AUTH_SECRET firma la cookie de sesión: generarlo con `openssl rand -base64 32`.
# Cambiar cualquiera de las dos cierra todas las sesiones abiertas.
APP_PASSWORD=
AUTH_SECRET=
